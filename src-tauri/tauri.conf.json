{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nikkePwned",
  "version": "4.2.0",
  "identifier": "com.scathachgrip.nikkepwned",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "nikkePwned",
        "width": 950,
        "height": 650,
        "minWidth": 450,
        "minHeight": 250,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
