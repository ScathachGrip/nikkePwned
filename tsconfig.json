{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["bun"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "package.json"]
}
