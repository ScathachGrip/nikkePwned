{
  "name": "nikkepwned",
  "version": "5.0.0",
  "description": "Password Manager for NIKKE",
  "keywords": [],
  "author": "sinkaroid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScathachGrip/nikkepwned.git"
  },
  "type": "module",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/bun": "^1.4.0",
    "svelte": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "scripts": {
    "build:ui": "vite build",
    "build:debug": "bun run build:ui && cd src-tauri && cargo build",
    "build:release": "bun run build:ui && cd src-tauri && cargo build --release",
    "build": "bun run build:release",
    "dev": "vite",
    "tauri:dev": "bun run build:ui && cd src-tauri && cargo tauri dev",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}